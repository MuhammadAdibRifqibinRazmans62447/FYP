.card {
  margin-top:2%;
}


</style>
        
        <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
        <title>Menu</title>
    </head>
<body>

  <nav id="na"class="navbar navbar-light bg-light">
    <div class="container-fluid">
      <span class="navbar-brand mb-0 h1"> Table   <%= tableid%> <small >  </small></span>
      <span class="d-flex">
          
          
      </span>
    </div>
  </nav>

    <div class="bg-dark p-3">
        <div class="row mx-0 bg-light">
            <div class="col-sm-8">

                <div class="card mb-3 rounded-pill" >
                    <div class="card-body">
                 <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
         <li class="nav-item">
           <a class="nav-link active" id="pills-food-tab" data-toggle="pill" href="#pills-food" role="tab" aria-controls="pills-food" aria-selected="true">Food</a>
         </li>
         <li class="nav-item">
           <a class="nav-link" id="pills-drink-tab" data-toggle="pill" href="#pills-drink" role="tab" aria-controls="pills-drink" aria-selected="false">Drink</a>
         </li>
         <li class="nav-item">
           <a class="nav-link" id="pills-sideDish-tab" data-toggle="pill" href="#pills-sideDish" role="tab" aria-controls="pills-SideDish" aria-selected="false">Side Dish</a>
         </li>
       </ul>
                </div> 
                </div>


               
         <div class="tab-content " id="pills-tabContent">
            <div class="tab-pane fade show active" id="pills-food" role="tabpanel" aria-labelledby="pills-food-tab">

            
                <div class="container">
                    <div class="row">
                        
                      <%   if (foods.length > 0) {                 %>
                        <% foods.forEach((food, index) => { %>
                          
                      <div class="col-md-3">
                        <div class="card" onclick="orderbasket('<%= food.foodname %>', '<%= food.price %>', '<%= food.menuid %>');">
                          <img src="/<%= foodimages[index].imagepath %>" class="card-img-top" alt="">
                          <div class="card-body">
                            <h5 class="card-title"><%= food.foodname %></h5>
                            <p class="card-text fw-bold"> RM <%= food.price %></p>
                          </div>
                        </div>
                      </div>
                  
                      <%  }) %> 

                      <% } else { %>
                        <p>There are no supply requests to display</p>
                    <% } %>
                        
                    </div>
                  </div>


                        








             
            </div>

             <div class="tab-pane fade" id="pills-drink" role="tabpanel" aria-labelledby="pills-drink-tab">
               
                <div class="container">
                    <div class="row">


                     <%   if (drinks.length > 0) {                 %>
                      <% drinks.forEach((drink, index) => { %>
                        <div class="col-md-3"> 
                        <div class="card" onclick="orderbasket('<%= drink.foodname %>', '<%= drink.price %>', '<%= drink.menuid %>');">
                  <img src="/<%= drinkimages[index].imagepath %>" class="card-img-top" alt="...">
                  <div class="card-body">
                    <h5 class="card-title"><%= drink.foodname %></h5>
                            <p class="card-text fw-bold"> RM <%= drink.price %></p>
                  </div>
                 
                </div>
                </div>
                <%  }) %> 

                <% } else { %>
                  <p>There are no supply requests to display</p>
              <% } %>
             
                



              </div> 
                  </div>

             </div>



                  <div class="tab-pane fade" id="pills-sideDish" role="tabpanel" aria-labelledby="pills-sideDish-tab">
                    <div class="container">
                        <div class="row">


                         <%   if (sides.length > 0) {                 %>
                          <% sides.forEach((side, index) => { %> 
                            <div class="col-md-3">  
                            <div class="card" onclick="orderbasket('<%= side.foodname %>', '<%= side.price %>', '<%= side.menuid %>');">
                   <img src="/<%= sidesimages[index].imagepath %>" class="card-img-top" alt="...">
                   <div class="card-body">
                    <h5 class="card-title"><%= side.foodname %></h5>
                    <p class="card-text fw-bold"> RM <%= side.price %></p>
                   </div>
                            </div>
                 </div>
                 <%  }) %>  
                        
                <% } else { %>
                  <p>There are no supply requests to display</p>
              <% } %>
                     
                    
                        
                    </div>
                 </div>

                </div>







        </div>       
            </div>


            <div class="col-sm-4">
            
                <div class="card">
                    <div class="card-body">
                        <h5 class='d-flex justify-content-between align-items-center'><span>Order</span><button onclick="orderbasketClear()"class="btn btn-sm btn-danger">Clear</button></h5>
                        <hr>
                        
             <ul id="orderlist" class="list-unstyled" style="Min-height:50vh; overflow-y:auto;">
                            
                            
                        </ul>
                        <hr>
                        <ul class="list-unstyled " style="height:50%; overflow-y:auto;">
                            <li class="d-flex justify-content-between align-items-center"> 
                                <big>Total Items: </big> <big id="totalitems"class="fw-bold card-text">0</big>
                            </li>
                            <li class="d-flex justify-content-between align-items-center">
                            <big>Total Amount: </big> <big class="fw-bold">RM <span id="totalcost"class="card-text">0.00</span></big>
                            </li>
                            <li>
                         <hr>
                         <button  class="btn btn-primary btn-lg w-100" onclick="OtherPage();">Check Out</button>
                            </li>
                        </ul>
                       
                    </div> 
                </div>
            </div>








        </div>
    </div>

    <form id="myForm" action="/cust/processMenu/<%= tableid%>" method="post" style="display: none;">
      <!-- Your form fields go here -->
    <!--  <label for="inputField"  >Input:</label> -->
    
      <input type="hidden" id="jsonDataInput" name="jsonData" value="">
      <input type="hidden" id="jsonData2" name="otherJson" value="">
      
      <!-- Add a hidden submit button -->
      <input type="submit" id="hiddenSubmit" >
  </form>

    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
   
    <script>
        
        
        const orderitemidarray =[];
        const orderarray=[];
        const orderitemarray=[];
        const orderarrayPrice=[];
       // const MenuId=[];
        const orderidarray=[];
        const orderSendQunatity=[];
        
        const orderItemQuantity = [];
        let i =0;
        function orderbasket(itemname,itemprice,id){
        
        if(orderarray.indexOf(itemname) > -1){
            
            const itemIndexNumber = orderarray.indexOf(itemname);
            orderItemQuantity[itemIndexNumber] = orderItemQuantity[itemIndexNumber] + 1;
            orderSendQunatity[itemIndexNumber] = orderSendQunatity[itemIndexNumber] + 1;
            
            incrementItem(orderidarray[itemIndexNumber],1);
            
            
       } else{
         
        orderidarray.push(i);    
        orderarray.push(itemname);
        orderarrayPrice.push(itemprice);  
     //   MenuId.push(menuid);
            
        orderitemidarray.push(id); 
        orderItemQuantity.push(1);
        orderSendQunatity.push(1);
            
        let orderlist = document.getElementById('orderlist');
        
        //crerate li
        
         const orderitemparent = document.createElement('li');
        const orderitem = document.createElement('span');
        orderitem.className ="d-flex justify-content-between align items-center";
       
        
        
        
        const orderitemspan = document.createElement('span');
        const orderitempricespan =document.createElement('span');
        //add text Node
        const orderitemname = document.createTextNode(itemname);
        const ordeitemprice = document.createTextNode(" RM " +(Math.round(itemprice * 100) / 100).toFixed(2));
        
        orderitempricespan.className='text-danger';
        orderitemspan.className='text-danger';
        
        // price to span
        
        orderitempricespan.appendChild(ordeitemprice);
      
      // delete button
      
      const deletebutton = document.createElement('button');
      const deletebuttontext = document.createTextNode('X');
      deletebutton.setAttribute('onclick', 'deleteItem(' + i + ', this)');
      deletebutton.appendChild(deletebuttontext);
      
      deletebutton.className = 'btn btn-danger rounded-pill';
        
        const orderitemleftsidespan = document.createElement('span');
        orderitemleftsidespan.appendChild(orderitemname);
        
        orderitemleftsidespan.appendChild(orderitempricespan);
        
        //itemname masuk dlm orderitem
        
        
        
        orderitem.appendChild(orderitemleftsidespan);
        
        
        
        
        // attach delete button
        orderitem.appendChild(deletebutton);
        
        
      //parent
       
       orderitemparent.appendChild(orderitem);
       //sapn masuk dlm orderitem
       // orderitem.appendChild(orderitemspan);
        
        orderlist.appendChild(orderitemparent);
        
        
        // button
        // orderitem.appendChild(document.createElement('br'));
         const decrementButton = document.createElement('button');
         const incrementButton = document.createElement('button');
         const decrementButtonText = document.createTextNode('-');
         const incrementButtonText = document.createTextNode('+');
         decrementButton.setAttribute('onclick', 'incrementItem('+i+',-1)');
         incrementButton.setAttribute('onclick', 'incrementItem('+i+',+1)');
         
         const amountSpan = document.createElement('span');
         amountSpan.className='px-3 fw-bold item'+i;
         const amountText = document.createTextNode('1');
         
        
         
        
         decrementButton.className='btn-sm btn btn-danger rounded-pill px-3 ms-1 fw-bold';
         incrementButton.className='btn-sm btn btn-success rounded-pill px-3 fw-bold';
         
         
         decrementButton.appendChild(decrementButtonText);
         incrementButton.appendChild(incrementButtonText);
         amountSpan.appendChild(amountText);
         orderitemparent.appendChild(incrementButton);
         orderitemparent.appendChild(amountSpan);
         orderitemparent.appendChild(decrementButton);
        
        
        i++;
        console.log(orderItemQuantity);
         
        }
        
        
        
        
        totalitems(); 
        costitem();
       
        
        
        
        
     };
        //  <li>Teh O <span class="text-danger">RM 2.00</span></li>
        
        
      //  function decrementItem(){
            
            
      //  }
        
        function incrementItem(orderid,val){
            
            const itemSpan = document.querySelector('.item'+ orderid);
            itemSpan.innerText = parseInt(itemSpan.innerText) + val;
            
             const indexnum = orderidarray.indexOf(orderid);
             
             // qunatity of coresspond array index
             orderItemQuantity[indexnum] = parseInt(itemSpan.innerText);
             orderSendQunatity[indexnum] = parseInt(itemSpan.innerText);
             
         
             totalitems();
             costitem();
             
            if( itemSpan.innerText == 0){
                
              
                // gantikan dgn menuid
                orderitemidarray.splice(indexnum, 1);
 
 
 
                orderidarray.splice(indexnum, 1);
                orderarray.splice(indexnum, 1);
                orderItemQuantity.splice(indexnum,1);
                orderSendQunatity.splice(indexnum,1);
                orderarrayPrice.splice(indexnum, 1);
               
 
 totalitems();
 costitem();
 
 orderlist.removeChild(itemSpan.parentElement);
 //orderitemparent.removeChild(button.parentElement);
            }
            
            
            
            
            
            
            
        }
        
        
      function totalitems(){
        
          
      //   document.getElementById('totalitems').innerText = orderarray.length;
      
      if(orderItemQuantity.length){
        document.getElementById('totalitems').innerText  = orderItemQuantity.reduce((total,num)=>{return total+num});
    } else{
        
        document.getElementById('totalitems').innerText ='0';
    }
    
          
      };
      
      function costitem() {
     if (orderarrayPrice.length === 0) {
         document.getElementById('totalcost').innerText = 0;
     } else {
           const totalTempArray = [];
         orderItemQuantity.map((quantity, index)=>{
             
             totalTempArray.push(quantity * orderarrayPrice[index] );
         });
         
         document.getElementById('totalcost').innerText = totalTempArray.reduce(sumarray).toFixed(2);
         
         function sumarray(total, num) {
             return total + num;
         }
         
         
       
     }
 }
 
      
      
      
      function orderbasketClear(){
          
        let orderlist = document.getElementById('orderlist');  
        orderlist.innerHTML='';
        orderarray.length=0;
        orderarrayPrice.length=0;
        orderidarray.length=0;
        orderitemidarray.length=0;
       
        orderItemQuantity.length =0;
        orderSendQunatity.length =0;
    
        i=0;
        totalitems();
        costitem();
        
      }
      
      function deleteItem(orderid,button){
        
 const indexnum = orderidarray.indexOf(orderid);
 // ganti kan dgn menu id
 orderitemidarray.splice(indexnum, 1);
 
 
 
 orderidarray.splice(indexnum, 1);
 orderarray.splice(indexnum, 1);
 orderarrayPrice.splice(indexnum, 1);
 orderItemQuantity.splice(indexnum, 1);
 orderSendQunatity.splice(indexnum,1);
 
 
 totalitems();
 costitem();
 
 orderlist.removeChild(button.parentElement.parentElement);
 //orderitemparent.removeChild(button.parentElement);
 
 
 
      }
   

        
      //  console.log(tableid);
   
    
      function OtherPage() {
       
       console.log(orderItemQuantity);
       
        if (Array.isArray(orderitemidarray) && orderitemidarray.length === 0) {
    alert("Please Select Your Order");
  }else{
       
       var confirmed = window.confirm("Are you sure you want to proceed?");
       
       if(confirmed){
       
    

        // Convert the array to a JSON string
        let jsonData = JSON.stringify(orderitemidarray);
        let jsonData2 =JSON.stringify(orderItemQuantity);





        // Set the value of the hidden input field with JSON data
 document.getElementById('jsonDataInput').value = jsonData;
  document.getElementById('jsonData2').value = jsonData2;
 
     
       
 document.getElementById('hiddenSubmit').click();   
    
            }
            else{
                
                  alert("Cancled");
            }
            
            
     
        }   
     
     

}
 
         // Convert the array to a JSON string
        // let jsonData = JSON.stringify(orderitemidarray);
       //  let jsonData2 =JSON.stringify(orderItemQuantity);
 
 
 
 
 
      
  
      
      
 
 
 
 
 
 
 
   
   
   
        
    </script> 
    
    
 <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>
 <script src="https://cdn.jsdelivr.net/npm/popper.js@1.14.7/dist/umd/popper.min.js" integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous"></script>
 <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>  
       

</body>
