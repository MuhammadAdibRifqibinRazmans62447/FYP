<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

	<style>
		body, html {
			height: 100%;
			font-family: Arial, Helvetica, sans-serif;
			background-image: url("back3.jpg");
				background-size: cover;
			background-repeat: no-repeat;
			overflow: hidden;
		}
		
		.container {
			margin-left: auto;
			margin-right: auto;
			margin-top: 10%;
			border: 1px solid #ccc;
			max-width: 400px;
			padding: 40px;
			background-color: #fff;
			border-radius: 5px;
			box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
		}
		
		.container h1 {
			margin-top: 0;
			text-align: center;
			color: #333;
		}
		
		.form-group {
			margin-bottom: 20px;
		}
		
		label {
			font-weight: bold;
		}
		
		input[type="text"],
		input[type="password"] {
			width: 100%;
			padding: 10px;
			border: 1px solid #ccc;
			border-radius: 3px;
		}
		
		input[type="text"]:focus,
		input[type="password"]:focus {
			border-color: #888;
			outline: none;
		}
		
		.btn {
			background-color: #00bfff;
			color: #fff;
			padding: 14px 20px;
			border: none;
			border-radius: 3px;
			cursor: pointer;
			width: 100%;
			font-size: 16px;
		}
		
		.btn:hover {
			background-color: #0080ff;
		}
		
		.link {
			text-align: center;
			margin-top: 20px;
		}
		
		.link a {
			color: #00bfff;
			text-decoration: none;
		}
		
		.link a:hover {
			text-decoration: underline;
		}
		</style>

</head>
<body>

	<div class="container">
	<h1>Login to Online Restaurant Management</h1>
	<form name="frd"  method="post" action="/emp">
		<div class="form-group">
			<label for="username">Username</label>
			<input type="text" name="username" placeholder="Enter Username" required>
		</div>
		<div class="form-group">
			<label for="password">Password</label>
			<input type="password" name="password" placeholder="Enter Password" required>
		</div>
    
        

		
					
	  
					
			<input type="submit" name="btn" >


	</form>		

</div>
    
</body>
</html>