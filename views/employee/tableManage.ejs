<html>
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css" 
    integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">

    <script src="https://code.jquery.com/jquery-3.3.1.min.js"></script>
    <script src="https://code.jquery.com/jquery-migrate-1.4.1.min.js"></script>


    

        <title>Customer Table</title>



        <style>

body {
  background-color: #365ee2d8; /* Neon green background */
  color: #000; /* Black text for contrast */
}

        </style>

</head>



<body>

    <nav id="na"class="navbar navbar-light bg-light">
        <div class="container-fluid">
          <span class="navbar-brand mb-0 h1"> Employee   <%= id%> <small >  </small></span>
          <span class="d-flex">
              
              <a href="/emp/homepage">Home</a>
          </span>
        </div>
      </nav>
      
      <div class="bg-dark p-3">
         <div class="row mx-0 bg-light">        
             <div class="col-sm-8">



                <div class="tab-content " id="pills-tabContent">
                    <div class="tab-pane fade show active" id="pills-food" role="tabpanel" aria-labelledby="pills-food-tab">
      
      
                        <div class="container">
                            <div class="row">     
                             

                                <% tables.forEach(table => { %>
                                <div class="col-md-3">  
                                    <div class="card">
                                      <img src="/table.jpg" class="card-img-top" alt="">
                               <div class="card-body">
                                 <h5 class="card-title" id="tableCard" ><%=table.tableid%></h5>
                                <button><p class="card-text" data-doc="<%= table.tableid %>">Details</p></button> 
                                
                               </div>
                             </div>
                                </div>

                                <%  }) %>


                              
                            </div>
                        </div>


                    </div>
                </div>





             </div>

             <div class="col-sm-4">
            
                <div class="card">
                    <div class="card-body">
                        <h5 class='d-flex justify-content-between align-items-center'><span>Order</span><button class="btn btn-sm btn-danger" onclick="deletelol('<%= tableid%>','<%= id %>')">Delete Order</button>   </h5>
                        <hr>
                      
                        <ul id="orderlist" class="list-unstyled" style="min-height: 50vh; overflow-y: auto;">
                            <% if (menu.length > 0) { %>
                                <% menu.forEach((menuItem, index) => { %>
                                    <li>
                                        <span class="d-flex justify-content-between align-items-center">
                                            <span><%= foodArray[index].foodname %></span> <!-- Access foodname property of each foodArray item -->
                                            <%= menuItem.quantity %> <!-- Display quantity property of each menuItem -->
                                        </span>
                                    </li>
                                <% }); %>
                            <% } else { %>
                                <p>There are no orders to display.</p>
                            <% } %>
                        </ul>
                        
                       
                        <ul class="list-unstyled " style="height:50%; overflow-y:auto;">
                            



                            <li>
                         <hr>
                         <button class="btn btn-primary btn-lg w-100 btn-danger" onclick="editlol('<%= tableid%>')">Edit Order</button>

                            </li>
                        </ul>
                       
                    </div> 
                </div>
            </div>




         </div>
      </div>


      <form id="myForm2" action="/emp/cancleorder/<%= tableid%>/<%= id %>" method="get" style="display: none;">
        <!-- Your form fields go here -->
      <!--  <label for="inputField"  >Input:</label> -->
        <input type="text" id="table2" name="table2" value="" type="hidden">
        <input type="text" id="emp2" name="emp2" value="" type="hidden">
        
       
        
        <!-- Add a hidden submit button -->
        <input type="submit" id="hiddenSubmit2" >
    </form> 



    <script>

const tableDetails = document.querySelectorAll('p.card-text');

tableDetails.forEach(tableDetail => {
    tableDetail.addEventListener('click', (e) => {
        const endpoint = `/emp/retDetail/${tableDetail.dataset.doc}`;

        fetch(endpoint, {
            method: 'GET',
        })
        .then(response => response.json())
        .then(data => {
            // Handle the JSON response
            window.location.href = data.redirect; // Redirect to the specified URL
        })
        .catch(err => console.log(err));
    });
});





function deletelol(deletelmao, emp) {
    // Check if deletelmao is not a number
    if (isNaN(deletelmao)) {
        alert("SELECT TABLE FIRST");
        return; // Exit the function early
    }

    var confirmed = window.confirm("Are you sure you want to delete the order?");
    if (confirmed) {
      
        document.getElementById('hiddenSubmit2').click();
    } else {
        alert("Cancelled");
    }
}




function editlol(tableid) {
    if (confirm("Are you sure you want to Edit Theese Order")) {
      window.location.href = '/emp/editOrder/' + tableid;
    }
  }


    </script>  

    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.14.7/dist/umd/popper.min.js" integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>  

</body>

</html>


