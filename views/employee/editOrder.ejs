<html>
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css" 
    integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">

    <script src="https://code.jquery.com/jquery-3.3.1.min.js"></script>
    <script src="https://code.jquery.com/jquery-migrate-1.4.1.min.js"></script>


    <style>

body {
  background-color: #60ccecd8; /* Neon green background */
  color: #000; /* Black text for contrast */
}

        .container{

            margin-top: 5%;
        }




        .btn-primary a {
            color: white; /* Make the text white */
            text-decoration: none; /* Remove underline */
        }
        .btn-primary a:hover {
            color: white; /* Ensure text stays white on hover */
            text-decoration: none; /* Ensure underline doesn't appear on hover */
        }


        .btn-danger a {
            color: white; /* Make the text white */
            text-decoration: none; /* Remove underline */
        }
        .btn-danger a:hover {
            color: white; /* Ensure text stays white on hover */
            text-decoration: none; /* Ensure underline doesn't appear on hover */
        }


        .text-button {
    background: none;
    border: none;
    padding: 0;
    color: inherit;
    text-decoration: none;
    font: inherit;
    cursor: pointer;
}

.text-button:hover,
.text-button:focus {
    text-decoration: underline;
}
    </style>


    

        <title>Edit Order Table <%= tableid %> </title>

</head>
<body>

    <link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet" />

    <nav id="na"class="navbar navbar-light bg-light">
        <div class="container-fluid">
          <span class="navbar-brand mb-0 h1"> Employee   <%= id%> <small >  </small></span>
          <span class="d-flex">
              
              <a href="/emp/homepage">Home</a>
          </span>
        </div>
      </nav>

      <div class="container">
        <div class="row">
            <div class="col-12 mb-3 mb-lg-5">
                <div class="overflow-hidden card table-nowrap table-card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Order List</h5>
                        <span>
                        <a href="/emp/addingNewMenu/<%= tableid %>"  class="btn btn-light btn-sm">Add Item</a>
                        <button type="button" class="btn btn-danger" onclick="confirmCancle()">
                          Cancle
                        </button>
                      </span>
                        
                    </div>
                    <div class="table-responsive">  

    <table class="table align-middle mb-0 bg-white">
        <thead class="bg-light">
          <tr>
            <th>Order Id</th>
            <th>Item Name</th>
            <th>Quantity</th>
            <th>Status</th>
            <th>Actions </th>
            
           
          </tr>
        </thead>
        <tbody>

           
                <% menu.forEach((order, index) => { %>

          <tr>
            <td>
                <p class="fw-normal mb-1"> <%= order.idorder %> </p>

            </td>

            <td>
              <p class="fw-normal mb-1"> <%= foodArray[index].foodname %> </p>
          
            </td>
            <td>
                <p class="fw-normal mb-1"> <%= order.quantity %></p>


            </td>

            <td>
                <%= order.status %>  
            </td>

            <td>
              <button type="button" class="btn  btn-primary"   onclick="confirmEdit('<%=  tableid %>','<%=  order.idorder %>')" >
               Edit Order
                
              </button>

              <button type="button" class="btn btn-danger" onclick="confirmDelete('<%= tableid %>', '<%= order.idorder %>')" 
                <%= menu.length === 1 ? 'disabled' : '' %>>
          Delete
        </button>
            </td>

           

          </tr>
         
          <% }); %>
       


        </tbody>
      </table>


                    </div>

                </div>
               

            </div>
            
        </div>
      </div>



 </body>

 <script>


function confirmCancle() {
    if (confirm("Do you wanted to Cancle  ?")) {
      window.location.href = '/emp/custOrder' 
    }
  }

  function confirmDelete(tableid,idorder) {
    if (confirm("Are you sure you want to delete this employee?")) {
      window.location.href = '/emp/deleteOrderItem/' + tableid +'/'+idorder;
    }
  }

  function confirmEdit(tableid,idorder) {
    if (confirm("Are you sure you want to Update this Item?")) {
      window.location.href = '/emp/updateOrderItemForm/' + tableid +'/'+idorder;
    }
  }


</script>


  
<script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.14.7/dist/umd/popper.min.js" integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>  
</body>

</html>