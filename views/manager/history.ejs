<html>
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css" 
    integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">

    <script src="https://code.jquery.com/jquery-3.3.1.min.js"></script>
    <script src="https://code.jquery.com/jquery-migrate-1.4.1.min.js"></script>

    <title>History</title>

    <style>
    html,
       body {
    height: 100%;
    background: #c471f5; /* fallback for old browsers */
   
  }

  .intro {
  height: 100%;
}

table td,
table th {
  text-overflow: ellipsis;
  white-space: nowrap;
  overflow: hidden;
}

thead th,
tbody th {
  color: #fff;
}

tbody td {
  font-weight: 500;
  color: rgba(255,255,255,.65);
}

.card {
  border-radius: .5rem;
}



    </style>


</head>

<body>
    <link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet" />

    <nav id="na" class="navbar navbar-light bg-light ">
      <div class="container-fluid">
          <span class="navbar-brand mb-0 h1">Manager <%= id %> <small></small></span>
          <span class="d-flex flex-row-reverse">
              
              <div class="p-2"><a href="/mng/homepage">Home</a></div>
              <div class="p-2"><a href=""  onclick="return checkSales()">Check Sales</a></div>
              
              
          </span>

          
      </div>
  </nav>


      <section class="intro">
        <div class="bg-image h-100" >
          <div class="mask d-flex align-items-center h-100" >
            <div class="container">
              <div class="row justify-content-center">
                <div class="col-12">
                  <div class="card bg-dark shadow-2-strong">
                    <div class="card-body">
                      <div class="table-responsive">
                        <table class="table table-dark table-borderless mb-0">
                          <thead>
                            <tr>
                              <th scope="col">Bill id</th>
                              <th scope="col">Amount (RM)</th>
                              <th scope="col">Date</th>
                              <th scope="col">Status</th>
                              <th scope="col">Pay (RM)</th>
                              <th scope="col">Details</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% if (bill.length > 0) { %>
                                <% bill.forEach((billdetail, index) => { %>
                            <tr>
                              <th scope="row"><%= billdetail.billidref %></th>
                              <td>RM<%= billdetail.amount %></td>
                              <td><%= new Date(billdetail.date).toLocaleDateString('en-US', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' }) %></td>
                              <td><%= billdetail.status %></td>
                              <td>RM<%= billdetail.pay %></td>
                              <td>  <button type="button" class="btn btn-info" onclick="confirmDetail('<%= billdetail.billidref %>')">
                                Detail
                                
                              </button>           </td>
                            </tr>
                            <% }) %>
                            <% } else { %>
                                <p>There are no Bill to display</p>
                            <% } %>
                          
                         
                         
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>



      <script>





        function confirmDetail(billid) {
          if (confirm("Do you wanted to Check The Order Detail  ?")) {
            window.location.href = '/mng/historyDetail/'+billid 
          }
        }   
        function checkSales() {
                            if (confirm("Are you sure you want to check the sales?")) {
                                window.location.href = "/mng/salesCheck"; // Redirect to the desired URL
                            }
                            return false; // Prevent default button behavior
                        }
      
      
      </script>









<script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.14.7/dist/umd/popper.min.js" integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>  
</body>

</html>